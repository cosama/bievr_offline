loop_closer.cpp integration patch.

bievr_bridge: synchronous mode. With Config::synchronous the constructor
starts no workers and addFrame() integrates, loop-checks and optimizes each
keyframe inline, so an offline replay is deterministic.

--- modules/pgo/src/loop_closer.cpp
+++ modules/pgo/src/loop_closer.cpp
@@ -46,6 +46,7 @@
 
   initNoiseModels();
 
+  if (config_.synchronous) return;  // bievr_bridge: addFrame() runs every stage
   workers_.emplace_back(&LoopCloser::keyframeWorker, this);
   workers_.emplace_back(&LoopCloser::loopDetectWorker, this);
   workers_.emplace_back(&LoopCloser::icpWorker, this);
@@ -128,6 +129,28 @@
